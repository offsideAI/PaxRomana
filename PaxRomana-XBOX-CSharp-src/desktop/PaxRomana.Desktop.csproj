<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop build of the same game code (macOS, Windows, Linux), for trying the game without a console.
       Run with: dotnet run -c Release, in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>PaxRomana</AssemblyName>
    <RootNamespace>PaxRomana</RootNamespace>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Game\**\*.cs" LinkBase="Game" />
    <Compile Include="Program.cs" />
    <!-- the intro voice-over, copied next to the program as assets/voice/*.wav -->
    <Content Include="..\assets\**\*.wav" Link="assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
  </ItemGroup>
</Project>
