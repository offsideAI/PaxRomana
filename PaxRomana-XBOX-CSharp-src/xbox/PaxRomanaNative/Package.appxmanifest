<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- Publisher must match the subject of the signing certificate (see build.ps1). -->
  <Identity Name="PaxRomana.TertiaRoma.Native" Publisher="CN=PaxRomana" Version="1.0.0.0" />
  <mp:PhoneIdentity PhoneProductId="7b1e4d90-52c6-4a3f-9e8b-2f6a0d7c5e14" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Pax Romana: Tertia Roma (Native)</DisplayName>
    <PublisherDisplayName>Pax Romana</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="PaxRomanaNative.App">
      <uap:VisualElements
        DisplayName="Pax Romana: Tertia Roma (Native)"
        Description="Level Zero: take the keys from the castle vault"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="#0C0E18">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0C0E18" />
      </uap:VisualElements>
    </Application>
  </Applications>

</Package>
