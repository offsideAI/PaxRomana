<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- Publisher must match the subject of the signing certificate (see build.ps1). -->
  <Identity Name="PaxRomana.TertiaRoma" Publisher="CN=PaxRomana" Version="1.0.0.0" />
  <mp:PhoneIdentity PhoneProductId="3c9a7e52-1b64-4f8d-a2e7-5d0c9b816f43" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Pax Romana: Tertia Roma</DisplayName>
    <PublisherDisplayName>Pax Romana</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="PaxRomanaXbox.App">
      <uap:VisualElements
        DisplayName="Pax Romana: Tertia Roma"
        Description="Capture the Kremlin of a future Moscow"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="#0C0E18">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0C0E18" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- The embedded browser needs it, and the game loads its display fonts from the web. -->
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
