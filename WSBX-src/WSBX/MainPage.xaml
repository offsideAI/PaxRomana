<Page
    x:Class="WSBX.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0B1020">

    <!-- 5% margin keeps everything inside the TV-safe area. -->
    <Grid Background="#0B1020" Padding="48,27">
        <Canvas x:Name="Arena" Background="#101827">
            <Rectangle x:Name="Net" Fill="#33FFFFFF" />
            <TextBlock x:Name="ScoreLeft" Text="0" Foreground="DodgerBlue" FontSize="64" FontWeight="Bold" />
            <TextBlock x:Name="ScoreRight" Text="0" Foreground="Orange" FontSize="64" FontWeight="Bold" />
            <Rectangle x:Name="PaddleLeft" Fill="DodgerBlue" RadiusX="3" RadiusY="3" />
            <Rectangle x:Name="PaddleRight" Fill="Orange" RadiusX="3" RadiusY="3" />
            <Ellipse x:Name="Ball" Fill="White" />
        </Canvas>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock x:Name="Banner" Text="WSBX PONG" Foreground="White" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock x:Name="Message" Text="Press A to start" Foreground="#CCFFFFFF" FontSize="22" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
